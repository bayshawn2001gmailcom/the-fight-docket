# Fight Newsletter — Environment Variables Template
# Real values live in ~/.env (master keys file) or project .env
# Copy this file to .env and fill in your values — never commit .env

# Core pipeline
FIRECRAWL_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
BEEHIIV_API_KEY=your_key_here
BEEHIIV_PUBLICATION_ID=your_pub_id_here
IMGBB_API_KEY=your_key_here

# Beehiiv browser automation — used when API returns 403 (free plan limitation)
# Required for beehiiv_browser_post.py and the auto-fallback in beehiiv_post.py
BEEHIIV_EMAIL=your_beehiiv_email@example.com
BEEHIIV_PASSWORD=your_beehiiv_password

# Perplexity AI — real-time web research with citations: perplexity.ai/settings/api
# Model: sonar-pro (most capable), sonar (faster/cheaper)
PERPLEXITY_API_KEY=your_key_here

# Kie.ai — multi-model API: Flux.1 Kontext (images), Veo 3.1 (video): kie.ai
KIE_API_KEY=your_key_here

# The Odds API — free tier, 500 req/month: the-odds-api.com
ODDS_API_KEY=your_key_here

# Reddit API — free read-only app: reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here

# Twitter/X — bearer token for search
TWITTER_BEARER_TOKEN=your_token_here

# ── Social Media Automation (Instagram + Facebook Graph API) ──────────────
# One-time setup: run  python tools/refresh_tokens.py --setup
# These keys come from the same Facebook Developer App.

# Facebook App credentials (developers.facebook.com → your App → Settings → Basic)
FACEBOOK_APP_ID=your_app_id_here
FACEBOOK_APP_SECRET=your_app_secret_here

# Facebook Page — numeric ID from page URL (profile.php?id=XXXXXXXXXX)
FACEBOOK_PAGE_ID=61567987746089
FACEBOOK_PAGE_TOKEN=your_long_lived_page_token_here

# Instagram Business Account — numeric ID (Settings > Account > Switch to Professional)
INSTAGRAM_ACCOUNT_ID=your_ig_account_id_here
INSTAGRAM_PAGE_TOKEN=your_long_lived_page_token_here   # same token as Facebook

# Date the current token was issued — used by refresh_tokens.py for expiry tracking
INSTAGRAM_TOKEN_ISSUED_AT=YYYY-MM-DD

# Google Sheets — service account JSON for editorial CMS / content calendar
# Create at console.cloud.google.com → IAM → Service Accounts → Keys → JSON
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account.json

# Optional: path to canvas-fonts directory for Instagram graphics
# Defaults to tools/canvas-fonts/ or ../the-fight-docket/canvas-fonts/ if not set
CANVAS_FONTS_DIR=
