# The Fight Docket — Instagram Automation Credentials
# NEVER commit the real .env file — add .env to .gitignore
# Copy this to .env and fill in your actual credentials

# Instagram credentials (for instagrapi)
INSTAGRAM_USERNAME=thefightdocket@gmail.com
INSTAGRAM_PASSWORD=your_password_here

# Firecrawl API key (for crawling fight results)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# GitHub (optional — for automated pushes)
GITHUB_TOKEN=your_github_token_here

# Timezone for scheduling
TZ=America/New_York
